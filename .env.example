# Environment
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rastreio_bot
# Or separate credentials:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_NAME=rastreio_bot

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional Webhook URL (if not set, polling is used):
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook

# Tracking Worker Configuration
TRACKING_INTERVAL_MINUTES=15
TRACKING_JOB_ATTEMPTS=3
